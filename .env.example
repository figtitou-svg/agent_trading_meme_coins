# =============================================================
#  COPIEZ CE FICHIER EN `.env` ET REMPLISSEZ VOS VALEURS.
#  LE FICHIER `.env` EST EXCLU DE GIT — NE LE COMMITEZ JAMAIS.
# =============================================================
#
# Watcher 100% Solana/pump.fun, observation uniquement : plus aucune
# variable EVM (RPC, clé privée, contrats, gaz) n'est nécessaire — voir
# _archive_evm/execution.py pour l'ancien sniper Uniswap V2 (Base/Ethereum).

# ==================== MODE ====================
# true  = OBSERVATION : détecte + audite + enregistre pour le dashboard,
#         n'achète JAMAIS. Aucune clé privée ni wallet Solana requis.
#         (Seul mode disponible dans cette phase.)
WATCH_ONLY=true

# ==================== PORTEFEUILLE VIRTUEL (simulation) ====================
# Montant virtuel (€) "investi" sur chaque token au feu vert, pour suivre
# l'évolution du patrimoine simulé sur le dashboard. Aucun argent réel.
MEME_BUY_EUR=1.0
# Liquidité (USD) en dessous de laquelle une position est considérée morte
# (rug / liquidité retirée).
DEAD_LIQUIDITY_USD=20
# Si une position (ou un candidat) n'a jamais été coté(e) par DexScreener
# après ce délai (minutes), on abandonne (rug avant même l'indexation).
PENDING_TIMEOUT_MINUTES=30

# ==================== FILTRE DE TRACTION (post-migration Raydium) ====================
# Durée d'observation (minutes) avant tout achat virtuel, après l'audit
# RugCheck : le token doit prouver une vraie traction, pas juste passer un
# audit technique.
TRACTION_WINDOW_MINUTES=60
# Multiplicateur de liquidité exigé par rapport à la première cotation.
TRACTION_LIQUIDITY_MULT=2.0
# Volume (USD) sur la dernière heure exigé pour confirmer un intérêt réel.
TRACTION_MIN_VOLUME_USD=500

# ==================== NOTIFICATIONS (optionnel) ====================
# Bot Telegram séparé du détecteur ci-dessous — celui-ci ENVOIE les alertes
# (uniquement quand la traction est confirmée), il ne lit aucun groupe.
# Réutilisez le même bot que le projet trading_view.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chemin du fichier de réglages de notification écrit par le dashboard du
# projet trading_view (repo frère) ; ce watcher ne fait que le LIRE.
# Par défaut : ../trading_view/forex/_cache/notification_settings.json
# NOTIFICATION_SETTINGS_PATH=

# ==================== BASE DE DONNÉES ====================
# Chemin de memecoins.db, lu en lecture seule par le dashboard du projet
# trading_view (repo frère) pour afficher détections/positions virtuelles.
# Par défaut : ./memecoins.db (dans ce dossier).
# MEMECOINS_DB_PATH=

# ==================== SÉCURITÉ (RugCheck.xyz) ====================
RUGCHECK_API_BASE=https://api.rugcheck.xyz/v1
# Timeout d'un appel RugCheck (secondes) — évite de bloquer le watcher.
RUGCHECK_TIMEOUT=5
# Un token fraîchement créé n'est parfois pas encore indexé par RugCheck :
# nombre de tentatives et délai (secondes) entre elles.
RUGCHECK_RETRIES=3
RUGCHECK_RETRY_DELAY=2
# Concentration maximale tolérée du plus gros holder hors pool de liquidité (%).
MAX_TOP_HOLDER_PERCENT=30
# Espacement minimal (secondes) entre deux appels RugCheck consécutifs — leur
# API gratuite limite à ~1 req/s ; en dessous, 429 en continu.
RUGCHECK_MIN_INTERVAL_SECONDS=1.1
# Nombre max de candidats audités par cycle de confirmation (30s) — le reste
# attend le cycle suivant.
MAX_AUDITS_PER_CYCLE=15

# ==================== COTATIONS SOLANA ====================
# API publique pump.fun (frontend) — vérifiée en direct le 2026-07-26 contre
# frontend-api-v3.pump.fun (l'ancien domaine sans "-v3" renvoie HTTP 530).
PUMPFUN_FRONTEND_API=https://frontend-api-v3.pump.fun
# Timeout des appels HTTP pump.fun / DexScreener (secondes).
QUOTES_HTTP_TIMEOUT=10

# ==================== DÉTECTEUR TELEGRAM ====================
# Identifiants d'application (my.telegram.org) — compte UTILISATEUR, pas un
# bot : la plupart des groupes d'alpha fermés refusent les bots classiques.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_detector
# Channels à surveiller, séparés par des virgules (ex. "@groupe1,@groupe2").
# Vide par défaut — à remplir une fois les groupes identifiés.
TELEGRAM_CHANNELS=

# ==================== DÉTECTEUR ON-CHAIN (pump.fun) ====================
# Intervalle de polling des nouveaux tokens pump.fun (secondes).
ONCHAIN_POLL_INTERVAL_SECONDS=5
