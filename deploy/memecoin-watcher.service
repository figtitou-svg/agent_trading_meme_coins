[Unit]
Description=Watcher memecoins — observation pump.fun (Solana), double détecteur Telegram + on-chain
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -u main.py --listen
Restart=always
RestartSec=15
# Journaux : sudo journalctl -u memecoin-watcher -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
